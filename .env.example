APP_ENV=local
APP_NAME=py-payments-ledger
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# E2E com Fluxe B2B Suite: use os mesmos valores do spring-saas-core
# JWT_SECRET=local-dev-secret-min-32-chars-for-hs256-signing
# JWT_ISSUER=spring-saas-core
JWT_SECRET=change-me
JWT_ISSUER=local-auth
TOKEN_EXPIRES_SECONDS=3600

# OIDC/RS256: set JWKS_URI to enable RS256 validation via JWKS endpoint.
# When set, JWT_SECRET is ignored for token validation (RS256 public key from JWKS).
# When empty/unset, falls back to HS256 with JWT_SECRET (default for dev).
# Example: JWKS_URI=https://your-idp.example.com/.well-known/jwks.json
JWT_ALGORITHM=HS256
JWKS_URI=

RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_READ_PER_MIN=240

IDEMPOTENCY_TTL_SECONDS=86400

CHAOS_ENABLED=false
CHAOS_FAIL_PERCENT=0
CHAOS_LATENCY_MS=0

ORDERS_INTEGRATION_ENABLED=true
ORDERS_EXCHANGE=orders.x
ORDERS_QUEUE=payments.orders.events
ORDERS_ROUTING_KEYS=payment.charge_requested,order.confirmed

GATEWAY_PROVIDER=fake
STRIPE_API_KEY=
GATEWAY_MAX_RETRIES=3
GATEWAY_RETRY_BASE_DELAY=1.0
GATEWAY_RETRY_MAX_DELAY=30.0

SAAS_INTEGRATION_ENABLED=false
SAAS_EXCHANGE=saas.x
SAAS_QUEUE=payments.saas.events
SAAS_ROUTING_KEYS=tenant.created,tenant.updated,tenant.suspended,tenant.reactivated

WEBHOOK_DELIVERY_ENABLED=false
RECONCILIATION_INTERVAL_MINUTES=60
REPORT_REFRESH_INTERVAL_MINUTES=15

# Production: comma-separated allowed origins (e.g. https://app.example.com)
# Empty in local = CORS allows *
CORS_ORIGINS=http://localhost:4200
