# === py-payments-ledger — Railway Environment Variables ===
# Copie para as variáveis do Railway (Settings > Variables)
# Checklist go-live: fluxe-b2b-suite/docs/GO-LIVE-VENDA.md

APP_ENV=production
APP_NAME=py-payments-ledger
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# PostgreSQL (Railway managed — usa driver psycopg)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Redis (Railway managed)
REDIS_URL=${{Redis.REDIS_URL}}

# RabbitMQ (CloudAMQP free tier)
RABBITMQ_URL=amqp://user:pass@host:5672/

# JWT — DEVE ser o MESMO valor do spring-saas-core (JWT_HS256_SECRET)
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET
JWT_ISSUER=spring-saas-core
JWT_ALGORITHM=HS256
TOKEN_EXPIRES_SECONDS=3600

# Rate limiting
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_READ_PER_MIN=240
IDEMPOTENCY_TTL_SECONDS=86400

# Gateway de pagamento — produção: stripe (ou pagseguro, mercadopago)
GATEWAY_PROVIDER=stripe
STRIPE_API_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
GATEWAY_MAX_RETRIES=3

# Opcional: PagSeguro / MercadoPago (se usar multi-gateway)
# PAGSEGURO_TOKEN=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=

# Integração com orders
ORDERS_INTEGRATION_ENABLED=true
ORDERS_EXCHANGE=orders.x
ORDERS_QUEUE=payments.orders.events
ORDERS_ROUTING_KEYS=payment.charge_requested,order.confirmed

# Integração com saas-core
SAAS_INTEGRATION_ENABLED=true
SAAS_EXCHANGE=saas.x
SAAS_QUEUE=payments.saas.events
SAAS_ROUTING_KEYS=tenant.created,tenant.updated,tenant.suspended,tenant.reactivated

# CORS — lista exata dos frontends (produção). Incluir shop, admin-console, ops-portal
CORS_ORIGINS=https://shop.up.railway.app,https://admin-console.up.railway.app,https://ops-portal.up.railway.app

# Encryption at rest (AES-256-GCM) — OBRIGATÓRIO em produção
# Gerar com: python -m src.shared.encryption
ENCRYPTION_KEY=GENERATE_ME
